# Exemplo de variáveis de ambiente do VAPER.
# Copie para `.env` e preencha. NUNCA commite o `.env` (ele tem segredos).

# Responsável padrão das tasks (assignee). Prioridade sobre git user.name e usuário do SO.
VAPER_ASSIGNEE=

# ── Acesso ao Azure DevOps (feat-018) ────────────────────────────────────────
# Coletadas via task de confirmação (npm run task dialog feat-018-002). Lidas por
# .vaper/task-cli/lib/devops-config.js. O PAT é SEGREDO: só no .env local, nunca commitar.
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_BASE_URL=
AZURE_DEVOPS_PAT=

# Campo custom de "History" do work item — varia por process template do projeto.
# Onde achar: Project Settings > Process > <tipo de WI> > "Reference name" do campo.
# Vazio = Custom.History. Nome errado faz o PATCH falhar com 400 nomeando o campo.
AZURE_DEVOPS_HISTORY_FIELD=

# ── Conexão SAP/ADT ──────────────────────────────────────────────────────────
# NÃO fica aqui. É por alias de sistema (o SID), resolvido pelo landscape do SAP GUI
# + .lib/adt/sistemas.json; a senha é perguntada na hora. Ver .lib/adt/README.md.

# ── Acesso à Anthropic — engine `api` de extração da FS (feat-065) ────────────
# Coletadas via task de confirmação (npm run task dialog feat-065-010). Lidas por
# .vaper/task-cli/lib/anthropic-config.js. A API key é SEGREDO: só no .env local, nunca commitar.
# ANTHROPIC_MODEL e ANTHROPIC_MAX_TOKENS são opcionais (defaults: claude-opus-4-8 / 16000).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=
